# Fingerprinted build output (filenames change on every content change),
# so these can be cached hard instead of revalidated on every visit.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

/comp-sheets/assets/*
  Cache-Control: public, max-age=31536000, immutable

/upload-portal/assets/*
  Cache-Control: public, max-age=31536000, immutable
